{
  "name": "@tvs/tvs-environment",
  "version": "0.1.0",
  "private": true,
  "description": "Shared environment profile module for TVS tooling",
  "scripts": {
    "build": "npm run build:dist",
    "rebuild": "npm run build:dist",
    "build:dist": "npm run build:dist:module",
    "build:dist:module": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./build/package.ps1"
  }
}
